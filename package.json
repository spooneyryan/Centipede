{
  "name": "rustipede",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Centipede, ported from the Rust original to TypeScript on GameBase — internet co-op, editable sprites and sounds, a level designer, replays, skins, telemetry.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "relay": "dotnet run --project server",
    "start": "npm run build && dotnet run --project server",
    "check": "node scripts/check.mjs",
    "desktop": "npm run build && electron desktop/main.cjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.21.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
